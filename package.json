{
  "name": "barge-decky-plugin",
  "version": "0.1.0",
  "description": "Decky Loader plugin to control a Barge machine (barged) from Steam Deck Gaming Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflatable-cookie/barge-decky-plugin.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "barge",
    "barged",
    "wake-on-lan"
  ],
  "author": "inflatable-cookie",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inflatable-cookie/barge-decky-plugin/issues"
  },
  "homepage": "https://github.com/inflatable-cookie/barge-decky-plugin#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
